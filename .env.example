# Create a key in the Anthropic Console and set it in Vercel Project Settings → Environment Variables.
# Never paste a real key into this file or into frontend JavaScript.
ANTHROPIC_API_KEY=replace_with_server_side_secret
CLAUDE_MODEL=claude-sonnet-5-5

# Optional: exact origins allowed to call the API, comma-separated.
# The Vercel preview/production host and arjunrose.github.io are included by default.
# Use SITE_ORIGIN for a custom Vercel production domain if needed.
# ALLOWED_ORIGINS=https://arjunrose.github.io,https://your-domain.example
# SITE_ORIGIN=https://your-project.vercel.app
